---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없어요">
  <h1>페이지를 찾을 수 없어요</h1>
  <p>주소가 바뀌었거나 삭제된 글일 수 있어요. <a href="/">글 목록</a>에서 찾아보거나 <a href="/search">검색</a>해 보세요.</p>
</Base>

<style>
  h1 {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin: 0 0 12px;
  }
  p {
    color: var(--fg-secondary);
    margin: 0;
  }
  a {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--border-strong);
  }
</style>
