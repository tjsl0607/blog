---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Comments from '../../components/Comments.astro';
import { getPosts, formatLong, isoDate, readingMinutes, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // 목록이 최신순이므로 index가 작을수록 최신 글이에요
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingMinutes(post.body);
---

<Base title={post.data.title} description={post.data.description} type="article" wide>
  <div class="layout">
    <article data-pagefind-body>
      <a href="/" class="back" data-pagefind-ignore>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg>
        글 목록
      </a>

      <header>
        <h1>{post.data.title}</h1>
        <p class="meta" data-pagefind-ignore>
          <time datetime={isoDate(post.data.date)}>{formatLong(post.data.date)}</time>
          <span>{minutes}분 분량</span>
        </p>
      </header>

      <div class="prose">
        <Content />
      </div>

      <nav class="pager" aria-label="이전 글, 다음 글" data-pagefind-ignore>
        <div>
          {older && (
            <a href={`/posts/${older.id}/`}>
              <span class="label">이전 글</span>
              <span class="t">{older.data.title}</span>
            </a>
          )}
        </div>
        <div class="right">
          {newer && (
            <a href={`/posts/${newer.id}/`}>
              <span class="label">다음 글</span>
              <span class="t">{newer.data.title}</span>
            </a>
          )}
        </div>
      </nav>

      <Comments />
    </article>

    <aside class="aside">
      <Toc headings={headings} />
    </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr min(var(--content), 100%) 1fr;
  }
  article {
    grid-column: 2;
    padding: 0 24px;
    min-width: 0;
  }
  .aside {
    grid-column: 3;
    padding: 132px 24px 0 24px;
    max-width: 260px;
    display: none;
  }
  @media (min-width: 1180px) {
    .aside {
      display: block;
    }
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--fg-secondary);
    margin-bottom: 40px;
    transition: color 0.15s;
  }
  .back:hover {
    color: var(--fg);
  }
  h1 {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.38;
    letter-spacing: -0.03em;
    margin: 0 0 14px;
  }
  .meta {
    display: flex;
    gap: 14px;
    margin: 0 0 48px;
    font-size: 14px;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 72px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .right {
    text-align: right;
  }
  .label {
    font-size: 12.5px;
    color: var(--fg-muted);
  }
  .t {
    font-size: 15px;
    line-height: 1.5;
    transition: color 0.15s;
  }
  .pager a:hover .t {
    color: var(--fg-secondary);
  }
  @media (max-width: 480px) {
    h1 {
      font-size: 24px;
    }
  }
</style>
