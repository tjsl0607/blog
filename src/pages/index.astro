---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { getPosts, groupByYear, formatShort, isoDate } from '../lib/posts';

const groups = groupByYear(await getPosts());
---

<Base>
  <section class="intro">
    <h1>{SITE.intro.heading}</h1>
    <p>{SITE.intro.body}</p>
  </section>

  <section aria-label="글 목록">
    {groups.map(([year, posts]) => (
      <div class="year">
        <h2>{year}</h2>
        <ul>
          {posts.map((post) => (
            <li>
              <a href={`/posts/${post.id}/`}>
                <span class="title">{post.data.title}</span>
                <time datetime={isoDate(post.data.date)}>{formatShort(post.data.date)}</time>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Base>

<style>
  .intro {
    margin-bottom: 64px;
  }
  h1 {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.025em;
    margin: 0 0 12px;
  }
  .intro p {
    margin: 0;
    color: var(--fg-secondary);
    line-height: 1.8;
  }
  .year + .year {
    margin-top: 36px;
  }
  h2 {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--fg-muted);
    margin: 0 0 6px;
    font-variant-numeric: tabular-nums;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding: 9px 0;
  }
  .title {
    font-size: 16px;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 0.15s;
  }
  li a:hover .title {
    text-decoration-color: var(--fg-muted);
  }
  time {
    flex-shrink: 0;
    font-size: 13.5px;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
